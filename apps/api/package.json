{
  "name": "@shark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply shark-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shark-db --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@shark/shared": "*",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  }
}
