# Used by the Node entry (npm run dev:api). Copy to .env
PORT=8787
ALLOWED_ORIGINS=http://localhost:4321

# --- Email (Resend: https://resend.com) -------------------------------------
# With RESEND_API_KEY + FROM_EMAIL set, every booking emails the owner (NOTIFY_EMAIL,
# defaults to the email on the site) and sends the learner a confirmation.
RESEND_API_KEY=
FROM_EMAIL=Shark Driving School <bookings@sharkdrivingschools.com>
NOTIFY_EMAIL=
# Set to false to stop the learner confirmation email.
EMAIL_CUSTOMER=true

# --- WhatsApp alerts to the owner -------------------------------------------
# WHATSAPP_TO defaults to the number on the site (447440260063).
# Option A (simplest): WHATSAPP_PROVIDER=callmebot + CALLMEBOT_API_KEY (see docs/DEPLOYMENT.md)
# Option B (official): WHATSAPP_PROVIDER=cloud + the WHATSAPP_CLOUD_* values
WHATSAPP_PROVIDER=
WHATSAPP_TO=
CALLMEBOT_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=en_GB

# Live Google reviews on the home page (GET /api/reviews). Places API (New) key, restricted to
# that API, with a daily request limit (see docs/DEPLOYMENT.md). Empty = site keeps its own reviews.
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=ChIJ8f6ZyT6xe0gRJnndLD5SVfE   (defaults to the business listing)
