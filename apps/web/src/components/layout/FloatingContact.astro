---
/**
 * Floating WhatsApp button (marketing pages). Calling is already in the header,
 * so this is the one quick way to message us from anywhere on the page.
 * It hides while the footer is on screen so it never covers the footer links
 * (scripts/whatsapp-fab.ts).
 */
import Icon from '@/components/ui/Icon.astro';
import { whatsappHref } from '@/config/site';
---

<a class="wa-fab" href={whatsappHref} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp" data-wa-fab>
  <Icon name="whatsapp" size={26} strokeWidth={2} />
  <span class="wa-fab__tip" aria-hidden="true">Chat on WhatsApp</span>
</a>

<script>
  import { initWhatsappFab } from '@/scripts/whatsapp-fab';
  initWhatsappFab();
</script>

<style>
  .wa-fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--whatsapp);
    color: var(--white);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.25s,
      visibility 0s;
  }
  .wa-fab:hover {
    transform: scale(1.06);
    color: var(--white);
  }
  /* Hidden while the footer is visible. */
  .wa-fab.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.25s,
      visibility 0s 0.25s;
  }

  /* Hover label (desktop only). */
  .wa-fab__tip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translate(6px, -50%);
    padding: 7px 12px;
    border-radius: var(--r-pill);
    background: var(--navy);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease-out);
  }
  .wa-fab:hover .wa-fab__tip,
  .wa-fab:focus-visible .wa-fab__tip {
    opacity: 1;
    transform: translate(0, -50%);
  }
  @media (hover: none) {
    .wa-fab__tip {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .wa-fab {
      right: 16px;
      bottom: 16px;
      width: 50px;
      height: 50px;
    }
  }
</style>
