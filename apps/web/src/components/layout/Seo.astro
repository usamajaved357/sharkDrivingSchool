---
import { site } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  /** Set false for pages that shouldn't be indexed (e.g. booking success states). */
  index?: boolean;
}
const { title, description = site.description, index = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const ogImage = new URL('/images/logo.jpg', Astro.site ?? site.url).href;

// Local SEO: tells Google this is a driving school in Manchester.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DrivingSchool',
  name: site.name,
  url: site.url,
  telephone: `+44${site.phone.tel.slice(1)}`,
  email: site.email,
  image: ogImage,
  areaServed: site.region,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'GB' },
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!index && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
