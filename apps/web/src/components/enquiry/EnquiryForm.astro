---
/**
 * The /book page form: a learner sends their details and the school contacts them to
 * arrange lessons (no calendar or time slots). Field names match EnquiryRequestSchema in
 * @shark/shared; scripts/enquiry-form.ts validates with it and posts to /api/enquiries.
 */
import { mailtoHref, site, telHref } from '@/config/site';
import EnquiryAside from './EnquiryAside.astro';
import EnquiryDone from './EnquiryDone.astro';
import FieldsAboutYou from './FieldsAboutYou.astro';
import FieldsAvailability from './FieldsAvailability.astro';
import FieldsLessons from './FieldsLessons.astro';
import FieldsTest from './FieldsTest.astro';
---

<div class="wrap eq">
  <h1 class="d eq__title">Book your lessons</h1>
  <p class="eq__intro">Tell us a little about you and we'll call or WhatsApp you to arrange everything. Fields marked * are required.</p>

  <div class="eq__layout">
    <div class="eq__card">
      <form data-enquiry-form novalidate>
        <noscript>
          <p class="eq__noscript">
            This form needs JavaScript. Please call <a href={telHref}>{site.phone.display}</a> or email <a href={mailtoHref}>{site.email}</a>.
          </p>
        </noscript>
        <FieldsAboutYou />
        <FieldsLessons />
        <FieldsTest />
        <FieldsAvailability />

        <p class="eq__error" data-form-error role="alert" hidden></p>
        <button type="submit" class="btn btn--red btn--block eq__submit" data-submit>Send my details</button>
        <p class="eq__small">No payment needed. We'll only use your details to arrange your lessons.</p>
      </form>
      <EnquiryDone />
    </div>
    <EnquiryAside />
  </div>
</div>

<script>
  import { initEnquiryForm } from '@/scripts/enquiry-form';
  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
  if (form) initEnquiryForm(form);
</script>

<style>
  .eq {
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .eq__title {
    font-size: clamp(40px, 5vw, 60px);
  }
  .eq__intro {
    margin: 12px 0 30px;
    max-width: 640px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }
  .eq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 32px;
    align-items: start;
  }
  .eq__card {
    background: var(--white);
    border-radius: var(--r-xl);
    padding: 34px;
    border: 1px solid var(--line);
  }
  /* Shared by the field sections (FieldsAboutYou, FieldsLessons, FieldsTest, FieldsAvailability). */
  .eq :global(.eq-group) {
    border: 0;
    padding: 0 0 26px;
    margin: 0 0 26px;
    min-width: 0;
    border-bottom: 1px solid var(--line);
  }
  .eq :global(.eq-legend) {
    padding: 0;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }
  .eq :global(.eq-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .eq :global(.eq-grid[hidden]) {
    display: none;
  }
  .eq :global(.eq-wide) {
    grid-column: 1 / -1;
  }
  .eq :global(.eq-opt) {
    font-weight: 500;
  }
  .eq :global(.field label) {
    font-size: 14px;
  }
  .eq :global(.field input),
  .eq :global(.field select) {
    height: 50px;
    font-size: 16px;
  }
  .eq :global(.eq-check) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    cursor: pointer;
  }
  .eq :global(.eq-check input) {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--red);
  }
  .eq :global(.eq-check a) {
    color: var(--blue);
    font-weight: 600;
  }
  .eq__error {
    margin: 20px 0 0;
    padding: 12px 16px;
    border-radius: var(--r-sm);
    background: var(--red-tint);
    color: var(--red-2);
    font-weight: 600;
  }
  .eq__submit {
    margin-top: 24px;
  }
  .eq__small {
    margin: 12px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .eq__noscript {
    padding: 16px;
    background: var(--paper);
    border-radius: var(--r-sm);
  }
  @media (max-width: 960px) {
    .eq__layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .eq__card {
      padding: 22px;
    }
    .eq :global(.eq-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
