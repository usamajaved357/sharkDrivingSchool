---
/** Enquiry form, part 2: gearbox, experience, instructor preference and (optional) what they're after. */
import ChoiceChips from '@/components/ui/ChoiceChips.astro';
import { EXPERIENCE_LABELS, INSTRUCTOR_PREF_LABELS, INTEREST_LABELS, TRANSMISSION_LABELS } from '@shark/shared';

const options = (labels: Record<string, string>) => Object.entries(labels).map(([value, label]) => ({ value, label }));
const instructor = [
  { value: 'male', label: 'Male instructor' },
  { value: 'female', label: 'Female instructor' },
  { value: 'any', label: 'No preference' },
];
// "Not sure yet" first; the rest follow the order on the prices page.
const interests = [{ value: 'not-sure', label: INTEREST_LABELS['not-sure'] }, ...options(INTEREST_LABELS).filter((o) => o.value !== 'not-sure')];
---

<fieldset class="eq-group">
  <legend class="eq-legend">Your lessons</legend>
  <div class="eq-grid">
    <ChoiceChips name="transmission" legend="Auto or manual" options={options(TRANSMISSION_LABELS)} required class="eq-wide" />
    <div class="field">
      <label for="eq-experience">Driving experience *</label>
      <select id="eq-experience" name="experience" aria-describedby="err-experience">
        <option value="" selected disabled>Choose one</option>
        {options(EXPERIENCE_LABELS).map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
      <span class="field-error" id="err-experience" data-error-for="experience"></span>
    </div>
    <div class="field">
      <label for="eq-interest">Interested in <span class="eq-opt">(optional)</span></label>
      <select id="eq-interest" name="interest">
        {interests.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
    <ChoiceChips name="instructorPref" legend="Male or female instructor" options={instructor} required class="eq-wide" />
  </div>
</fieldset>
