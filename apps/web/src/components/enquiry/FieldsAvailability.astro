---
/** Enquiry form, part 4: when the learner is free, anything else, and the consent box. */
import ChoiceChips from '@/components/ui/ChoiceChips.astro';
import { AVAILABILITY_LABELS } from '@shark/shared';

const slots = Object.entries(AVAILABILITY_LABELS).map(([value, label]) => ({ value, label }));
---

<fieldset class="eq-group">
  <legend class="eq-legend">Availability</legend>
  <div class="eq-grid">
    <ChoiceChips name="availability" type="checkbox" legend="When are you free for lessons?" hint="(tick any)" options={slots} required class="eq-wide" />
    <div class="field eq-wide">
      <label for="eq-avail-notes">Anything specific? <span class="eq-opt">(optional)</span></label>
      <input id="eq-avail-notes" name="availabilityNotes" type="text" maxlength="200" placeholder="e.g. after 5pm, not Wednesdays" aria-describedby="err-availabilityNotes" />
      <span class="field-error" id="err-availabilityNotes" data-error-for="availabilityNotes"></span>
    </div>
    <div class="field eq-wide">
      <label for="eq-notes">Anything else we should know? <span class="eq-opt">(optional)</span></label>
      <textarea id="eq-notes" name="notes" rows="3" maxlength="500" placeholder="e.g. nervous driver, best time to call" aria-describedby="err-notes"></textarea>
      <span class="field-error" id="err-notes" data-error-for="notes"></span>
    </div>
  </div>
</fieldset>

<label class="eq-check">
  <input type="checkbox" name="agreeTerms" value="true" aria-describedby="err-agreeTerms" />
  <span>
    I agree to the <a href="/terms" target="_blank">terms</a> and <a href="/privacy" target="_blank">privacy policy</a>, and to being contacted about lessons *
  </span>
</label>
<span class="field-error" id="err-agreeTerms" data-error-for="agreeTerms"></span>
