---
/** Booking step 1: gearbox and lesson type (prices follow the gearbox; see scripts/booking-wizard.ts). */
import { bookableLessons, defaultPrice } from '@/data/pricing';
---

<section class="bk__panel" data-step-panel="1" aria-labelledby="bk-s1">
  <h2 id="bk-s1" class="bk__h">What would you like to book?</h2>
  <p class="bk__sub">Choose your gearbox and lesson type.</p>

  <fieldset class="bk__fs bk__two">
    <legend class="sr-only">Gearbox</legend>
    <label class="opt">
      <input class="opt__input" type="radio" name="transmission" value="manual" checked data-label="Manual" />
      <span class="opt__dot" aria-hidden="true"></span>
      <span><b>Manual</b><br /><small>Drive any car after you pass</small></span>
    </label>
    <label class="opt">
      <input class="opt__input" type="radio" name="transmission" value="automatic" data-label="Automatic" />
      <span class="opt__dot" aria-hidden="true"></span>
      <span><b>Automatic</b><br /><small>No clutch, quicker to learn</small></span>
    </label>
  </fieldset>

  <fieldset class="bk__fs bk__stack">
    <legend class="sr-only">Lesson type</legend>
    {
      bookableLessons.map((l, i) => {
        const price = typeof l.price === 'string' ? { manual: l.price, automatic: l.price } : l.price;
        return (
          <label class="opt">
            <input
              class="opt__input"
              type="radio"
              name="lessonType"
              value={l.id}
              checked={i === 1}
              data-label={l.name}
              data-price-manual={price.manual}
              data-price-automatic={price.automatic}
            />
            <span class="opt__dot" aria-hidden="true" />
            <span class="opt__grow">
              <b>{l.name}</b>
              <br />
              <small>{l.desc}</small>
            </span>
            <span class="d opt__price" data-lesson-price>
              {defaultPrice(l.price)}
            </span>
          </label>
        );
      })
    }
  </fieldset>
</section>


<style>
  .bk__two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .bk__stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Radio option cards */
  .opt {
    position: relative;
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px;
    border-radius: 18px;
    border: 2px solid var(--line);
    background: var(--white);
    cursor: pointer;
    transition: all 0.2s;
  }
  .opt:hover {
    border-color: #b9cbea;
  }
  .opt b {
    font-size: 17px;
  }
  .opt small {
    color: var(--muted);
    font-size: 14px;
  }
  .opt__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opt__dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #b9c3d6;
    flex: none;
  }
  .opt:has(.opt__input:checked) {
    border-color: var(--red);
    box-shadow: 0 12px 30px -18px rgba(225, 6, 0, 0.6);
  }
  .opt:has(.opt__input:checked) .opt__dot {
    border-color: var(--red);
    background: var(--red);
    box-shadow: inset 0 0 0 4px var(--white);
  }
  .opt:has(.opt__input:focus-visible) {
    outline: 3px solid var(--sky);
    outline-offset: 2px;
  }
  .opt__grow {
    flex: 1;
  }
  .opt__price {
    font-size: 26px;
  }

  /* Days + slots (rendered by script → :global) */
  @media (max-width: 600px) {
    .bk__two {
      grid-template-columns: 1fr;
    }
  }
</style>
