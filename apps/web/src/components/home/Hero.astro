---
import Icon from '@/components/ui/Icon.astro';
import { site, telHref } from '@/config/site';
import { heroTrust } from '@/data/home';
import QuickBookingCard from './QuickBookingCard.astro';
---

<section id="top" class="hero">
  <div aria-hidden="true" class="d hero__watermark">SHARK</div>

  <!-- Animated perspective road -->
  <div class="road" aria-hidden="true">
    <div class="road__plane">
      <div class="road__edge" style="left: 6%"></div>
      <div class="road__lane" style="left: 36%"></div>
      <div class="road__lane" style="left: 64%"></div>
      <div class="road__edge road__edge--red" style="right: 6%"></div>
    </div>
  </div>

  <div class="wrap split hero__grid">
    <div>
      <div class="rise hero__pill">
        <span class="hero__pill-tag">NOW BOOKING</span>
        New learners across {site.region}
      </div>

      <h1 class="d rise dl1 h-xl hero__title">
        Drive fearless.<br />Pass with <span class="hero__bite"
          >bite.<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M2 14 Q 75 2 150 10 T 298 6" fill="none" stroke="#4C8DFF" stroke-width="5" stroke-linecap="round"
            ></path></svg
          ></span
        >
      </h1>

      <p class="rise dl2 hero__lead">{site.description}</p>

      <div class="rise dl3 hero__ctas">
        <a class="btn btn--red" href="/book">Book your first lesson <Icon name="arrow-right" size={18} strokeWidth={2.4} /></a>
        <a class="btn btn--ghost" href={telHref}><Icon name="phone" size={18} />{site.phone.display}</a>
      </div>

      <ul class="rise dl4 hero__trust">
        {
          heroTrust.map((t) => (
            <li>
              <span class="hero__trust-ic">
                <Icon name={t.icon} size={18} />
              </span>
              {t.label}
            </li>
          ))
        }
      </ul>
    </div>

    <QuickBookingCard />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: radial-gradient(1200px 600px at 75% -10%, #123a85 0%, transparent 60%), var(--navy);
    color: var(--white);
    overflow: hidden;
    /* Fills one screen (minus top bar + header) with the content centred, capped on tall screens. */
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 102px), 820px);
    padding: 56px 0 96px;
  }
  .hero > .wrap {
    width: 100%;
  }
  .hero__watermark {
    position: absolute;
    right: -40px;
    top: 20px;
    font-size: 240px;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.06);
    white-space: nowrap;
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    z-index: 2;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 430px);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Road */
  .road {
    position: absolute;
    left: 50%;
    bottom: -10px;
    width: 1300px;
    height: 440px;
    transform: translateX(-50%);
    perspective: 520px;
    pointer-events: none;
    /* Fades out early so lane markings stay below the text. */
    -webkit-mask-image: linear-gradient(to top, #000 12%, transparent 62%);
    mask-image: linear-gradient(to top, #000 12%, transparent 62%);
    opacity: 0.85;
  }
  .road__plane {
    position: absolute;
    inset: 0;
    transform: rotateX(64deg);
    transform-origin: 50% 100%;
    background: linear-gradient(to top, #0f2c66, #0a1f4a);
  }
  .road__lane {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 14px;
    margin-left: -7px;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.95) 0 80px, transparent 80px 180px);
    animation: dash 0.55s linear infinite;
  }
  .road__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    background: rgba(255, 255, 255, 0.35);
  }
  .road__edge--red {
    background: var(--red);
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 14px;
    font-weight: 600;
  }
  .hero__pill-tag {
    background: var(--red);
    padding: 4px 10px;
    border-radius: var(--r-pill);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .hero__title {
    margin-top: 24px;
    font-size: clamp(44px, 4.6vw, 70px);
    line-height: 0.98;
  }
  .hero__bite {
    color: var(--red);
    position: relative;
    display: inline-block;
  }
  .hero__bite svg {
    position: absolute;
    left: 0;
    bottom: -10px;
    width: 100%;
    height: 12px;
  }
  .hero__lead {
    font-size: 17px;
    line-height: 1.65;
    color: var(--on-dark-muted);
    max-width: 500px;
    margin: 28px 0 0;
    text-wrap: pretty;
  }
  .hero__ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .hero__ctas :global(.btn) {
    height: 50px;
    font-size: 15px;
  }
  .hero__trust {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 12px 24px;
    flex-wrap: wrap;
    margin: 36px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: #dce5f7;
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero__trust-ic {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: rgba(76, 141, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sky);
  }
  @media (max-width: 640px) {
    .hero {
      padding: 36px 0 80px;
    }
    .hero__watermark {
      font-size: 160px;
    }
    .hero__lead {
      font-size: 16px;
    }
  }
</style>
