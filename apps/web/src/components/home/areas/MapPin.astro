---
/**
 * One town on the coverage map. Towns are a single frosted pill with the dot inside
 * (the dot sits exactly on the coordinate); Manchester is a red marker with a navy label.
 */
interface Props {
  label: string;
  /** Position in percent of the map box. */
  left: number;
  top: number;
  side?: 'left' | 'right';
  main?: boolean;
  /** Hide on small maps (too close to the Manchester marker). */
  nearCentre?: boolean;
}
const { label, left, top, side = 'right', main = false, nearCentre = false } = Astro.props;
---

<li class:list={['mp', { 'mp--main': main, 'mp--left': side === 'left', 'mp--near': nearCentre }]} style={`left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`}>
  <span class="mp__dot" aria-hidden="true"></span>
  <span class="mp__label">{label}</span>
</li>

<style>
  .mp {
    position: absolute;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  /* Town tag: one frosted pill, dot inside. Dot centre = 6px padding + 4px = 10px from the edge. */
  .mp:not(.mp--main) {
    gap: 6px;
    padding: 4px 10px 4px 6px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(6, 20, 46, 0.08);
    box-shadow: 0 6px 14px -8px rgba(6, 20, 46, 0.45);
    -webkit-backdrop-filter: blur(6px) saturate(160%);
    backdrop-filter: blur(6px) saturate(160%);
    transform: translate(-10px, -50%);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s;
  }
  .mp--left:not(.mp--main) {
    flex-direction: row-reverse;
    padding: 4px 6px 4px 10px;
    transform: translate(calc(-100% + 10px), -50%);
  }
  .mp:not(.mp--main):hover {
    z-index: 2;
    box-shadow: 0 10px 20px -8px rgba(6, 20, 46, 0.5);
  }
  .mp__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 3px rgba(11, 77, 186, 0.18);
  }
  .mp__label {
    color: var(--ink);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* Manchester: red teardrop marker with a soft pulse. */
  .mp--main {
    transform: translate(-13px, -100%);
    align-items: flex-start;
  }
  .mp--main .mp__dot {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--red);
    box-shadow: 0 6px 14px -4px rgba(225, 6, 0, 0.7);
    position: relative;
  }
  .mp--main .mp__dot::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--white);
  }
  .mp--main {
    gap: 6px;
  }
  .mp--main .mp__label {
    margin-top: 2px;
    padding: 4px 11px;
    border-radius: var(--r-pill);
    font-size: 12.5px;
    color: var(--white);
    background: var(--glass-sheen), var(--navy);
    box-shadow: 0 8px 18px -8px rgba(6, 20, 46, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .mp--main::before {
    content: '';
    position: absolute;
    left: 5px;
    bottom: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  /* Small map: real towns sit close together, so keep only the Manchester label
     (every area is also listed as a chip beside the map). */
  @container cmap (max-width: 560px) {
    /* Dot only: drop the pill and give the dot a white ring so it reads on the map. */
    .mp:not(.mp--main) {
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      transform: translate(-50%, -50%);
    }
    .mp:not(.mp--main) .mp__label {
      display: none;
    }
    .mp:not(.mp--main) .mp__dot {
      width: 10px;
      height: 10px;
      border: 2px solid var(--white);
      box-shadow: 0 2px 6px rgba(6, 20, 46, 0.35);
    }
    .mp--near {
      display: none;
    }
    /* Manchester label sits above its marker so it clears the towns either side. */
    .mp--main {
      flex-direction: column-reverse;
      align-items: center;
      gap: 3px;
      transform: translate(-50%, -100%);
    }
    .mp--main::before {
      left: calc(50% - 8px);
    }
    .mp--main .mp__dot {
      width: 20px;
      height: 20px;
    }
    .mp--main .mp__dot::after {
      inset: 6px;
    }
    .mp--main .mp__label {
      margin-top: 0;
      font-size: 11px;
    }
  }
</style>
