---
/** One town on the coverage map: a map marker plus a small label (left or right of it). */
interface Props {
  label: string;
  /** Position in percent of the map box. */
  left: number;
  top: number;
  side?: 'left' | 'right';
  main?: boolean;
}
const { label, left, top, side = 'right', main = false } = Astro.props;
---

<li class:list={['mp', { 'mp--main': main, 'mp--left': side === 'left' }]} style={`left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`}>
  <span class="mp__dot" aria-hidden="true"></span>
  <span class="mp__label">{label}</span>
</li>

<style>
  .mp {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: translate(-6px, -50%);
    white-space: nowrap;
  }
  .mp--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 6px), -50%);
  }
  .mp__dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue);
    border: 2.5px solid var(--white);
    box-shadow: 0 2px 6px rgba(6, 20, 46, 0.35);
  }
  .mp__label {
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--white);
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 2px 8px -2px rgba(6, 20, 46, 0.3);
  }

  /* Manchester: red teardrop marker with a soft pulse. */
  .mp--main {
    transform: translate(-13px, -100%);
    align-items: flex-start;
  }
  .mp--main .mp__dot {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--red);
    box-shadow: 0 6px 14px -4px rgba(225, 6, 0, 0.7);
    position: relative;
  }
  .mp--main .mp__dot::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--white);
  }
  .mp--main .mp__label {
    margin-top: 2px;
    font-size: 13px;
    background: var(--navy);
    color: var(--white);
  }
  .mp--main::before {
    content: '';
    position: absolute;
    left: 5px;
    bottom: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  /* Small map: real towns sit close together, so keep only the Manchester label
     (every area is also listed as a chip beside the map). */
  @container cmap (max-width: 560px) {
    .mp:not(.mp--main) .mp__label {
      display: none;
    }
    .mp__dot {
      width: 10px;
      height: 10px;
      border-width: 2px;
    }
    .mp--main {
      transform: translate(-10px, -100%);
    }
    .mp--main .mp__dot {
      width: 20px;
      height: 20px;
    }
    .mp--main .mp__dot::after {
      inset: 6px;
    }
    .mp--main .mp__label {
      font-size: 11px;
    }
  }
</style>
