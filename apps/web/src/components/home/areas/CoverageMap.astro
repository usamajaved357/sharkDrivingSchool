---
/**
 * Decorative Greater Manchester coverage map: M60 ring with a car driving round it,
 * motorways, coverage rings and glass town labels, with the postcode check below.
 */
import { site } from '@/config/site';
import { areas, mapPins } from '@/data/areas';
import MapPin from './MapPin.astro';
import PostcodeCheck from './PostcodeCheck.astro';

// M60 ring, used for the road and for the car's route.
const ring = 'M85 150 a115 88 0 1 0 230 0 a115 88 0 1 0 -230 0';
---

<div class="cm reveal">
  <div class="cm__head">
    <div>
      <p class="cm__live"><i aria-hidden="true"></i> Coverage map</p>
      <p class="cm__title">{site.region}</p>
    </div>
    <span class="cm__count">{areas.length}+ areas</span>
  </div>

  <div class="cm__map" aria-hidden="true">
    <svg viewBox="0 0 400 300" class="cm__svg">
      <defs>
        <radialGradient id="cm-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" style="stop-color: var(--sky)" stop-opacity="0.35"></stop>
          <stop offset="100%" style="stop-color: var(--sky)" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <ellipse cx="200" cy="150" rx="190" ry="140" fill="url(#cm-glow)"></ellipse>

      <g class="cm__rings">
        <circle cx="200" cy="150" r="136" class="cm__ring"></circle>
        <circle cx="200" cy="150" r="96" class="cm__ring cm__ring--inner"></circle>
      </g>

      <g class="cm__roads">
        <path d="M0 108 C 90 100 150 72 220 62 S 340 38 400 16"></path>
        <path d="M60 22 C 100 66 128 92 150 116"></path>
        <path d="M172 232 C 140 262 112 284 84 300"></path>
        <path d="M244 210 C 270 240 290 264 312 300"></path>
        <path d="M312 152 C 345 156 372 152 400 150"></path>
      </g>

      <path d={ring} class="cm__m60-glow"></path>
      <path d={ring} class="cm__m60"></path>
      <g class="cm__m60-tag" transform="translate(119 88)">
        <rect x="-17" y="-10" width="34" height="20" rx="5"></rect>
        <text x="0" y="4.5" text-anchor="middle">M60</text>
      </g>

      <g class="cm__car">
        <circle r="9" class="cm__car-halo"></circle>
        <circle r="4.5" class="cm__car-dot"></circle>
        <animateMotion dur="14s" repeatCount="indefinite" path={ring}></animateMotion>
      </g>
    </svg>

    {mapPins.map((p) => <MapPin pin={p} />)}
  </div>

  <PostcodeCheck />
</div>

<style>
  .cm {
    position: relative;
    border-radius: 32px;
    padding: 22px;
    color: var(--white);
    background:
      radial-gradient(500px 300px at 50% 40%, rgba(18, 58, 133, 0.9), transparent 70%),
      var(--navy);
    box-shadow: var(--glass-highlight), 0 40px 80px -40px rgba(6, 20, 46, 0.6);
    overflow: hidden;
  }
  .cm__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 4px 6px 0;
  }
  .cm__live {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-subtle);
  }
  .cm__live i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--whatsapp);
    box-shadow: 0 0 0 4px rgba(31, 168, 85, 0.25);
  }
  .cm__title {
    margin: 4px 0 0;
    font-size: 20px;
    font-weight: 800;
  }
  .cm__count {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 700;
    background: var(--glass-dark-bg);
    border: 1px solid var(--glass-dark-border);
    box-shadow: var(--glass-highlight);
  }

  /* Map area: SVG and pins share the same 4:3 box so % positions line up. */
  .cm__map {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 14px 0;
    border-radius: 22px;
    overflow: hidden;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .cm__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cm__ring {
    fill: none;
    stroke: var(--red);
    stroke-opacity: 0.4;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    transform-origin: 200px 150px;
    animation: cm-spin 60s linear infinite;
  }
  .cm__ring--inner {
    stroke: var(--sky);
    animation-direction: reverse;
  }
  .cm__roads path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .cm__m60-glow {
    fill: none;
    stroke: var(--sky);
    stroke-opacity: 0.25;
    stroke-width: 14;
  }
  .cm__m60 {
    fill: none;
    stroke: var(--sky);
    stroke-width: 4;
  }
  .cm__m60-tag rect {
    fill: var(--blue);
    stroke: rgba(255, 255, 255, 0.5);
  }
  .cm__m60-tag text {
    fill: var(--white);
    font-size: 11px;
    font-weight: 800;
    font-family: var(--font-body);
  }
  .cm__car-halo {
    fill: var(--red);
    fill-opacity: 0.3;
  }
  .cm__car-dot {
    fill: var(--white);
    stroke: var(--red);
    stroke-width: 2.5;
  }

  @keyframes cm-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cm__car {
      display: none;
    }
  }
  /* The M60 sign is decoration; drop it where labels get crowded. */
  @media (max-width: 420px) {
    .cm__m60-tag {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .cm {
      padding: 16px;
      border-radius: 24px;
    }
  }
</style>
