---
/**
 * Coverage map: real OpenStreetMap tiles (toned to the brand) with pins at each town's
 * real coordinates, plus the postcode check below. No map library: tiles and pins are
 * positioned with lib/geo.ts. OpenStreetMap attribution is required and shown.
 */
import { site } from '@/config/site';
import { areas, mapPins, mapView } from '@/data/areas';
import { tilesFor, toPercent } from '@/lib/geo';
import MapPin from './MapPin.astro';
import PostcodeCheck from './PostcodeCheck.astro';

const tiles = tilesFor(mapView);
const pins = mapPins.map((p) => ({ ...p, ...toPercent(mapView, p.lat, p.lon) }));
---

<div class="cm reveal">
  <div class="cm__head">
    <div>
      <p class="cm__kicker">Coverage map</p>
      <p class="cm__title">{site.region}</p>
    </div>
    <span class="cm__count">{areas.length}+ areas</span>
  </div>

  <div class="cm__map">
    <div class="cm__tiles" aria-hidden="true">
      {
        tiles.map((t) => (
          <img
            src={`https://tile.openstreetmap.org/${mapView.zoom}/${t.x}/${t.y}.png`}
            alt=""
            width="256"
            height="256"
            loading="lazy"
            decoding="async"
            style={`left:${t.left}%;top:${t.top}%;width:${t.w}%;height:${t.h}%`}
          />
        ))
      }
    </div>
    <div class="cm__tint" aria-hidden="true"></div>
    <ul class="cm__pins" aria-label={`Areas on the map: ${mapPins.map((p) => p.label).join(', ')}`}>
      {pins.map((p) => <MapPin label={p.label} left={p.left} top={p.top} side={p.side} main={p.main} nearCentre={p.nearCentre} />)}
    </ul>
    <p class="cm__credit">
      © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
    </p>
  </div>

  <PostcodeCheck />
</div>

<style>
  .cm {
    padding: 20px;
    border-radius: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -40px rgba(6, 20, 46, 0.35);
  }
  .cm__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 4px 6px 0;
  }
  .cm__kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }
  .cm__title {
    margin: 4px 0 0;
    font-size: 20px;
    font-weight: 800;
    color: var(--ink);
  }
  .cm__count {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  /* Map: tiles, tint and pins share one 4:3 box so percent positions line up. */
  .cm__map {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 16px 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    /* Pins adapt to the map's own width (see MapPin.astro). */
    container: cmap / inline-size;
  }
  .cm__tiles img {
    position: absolute;
    max-width: none;
    /* Calm, brand-friendly map: muted colours, slightly cool. */
    filter: grayscale(0.85) contrast(0.95) brightness(1.04);
  }
  .cm__tint {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 56% 47%, rgba(11, 77, 186, 0.1), transparent 55%),
      linear-gradient(rgba(11, 77, 186, 0.06), rgba(11, 77, 186, 0.06));
    box-shadow: inset 0 0 60px rgba(6, 20, 46, 0.12);
    pointer-events: none;
  }
  .cm__pins {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cm__credit {
    position: absolute;
    right: 8px;
    bottom: 6px;
    margin: 0;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    color: var(--muted);
  }
  .cm__credit a {
    color: var(--blue);
  }
  @media (max-width: 640px) {
    .cm {
      padding: 14px;
      border-radius: 22px;
    }
  }
</style>
