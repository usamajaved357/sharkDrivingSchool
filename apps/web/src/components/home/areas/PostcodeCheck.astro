---
/** Postcode check under the coverage map. Behaviour is in scripts/coverage-check.ts. */
import Icon from '@/components/ui/Icon.astro';
---

<div class="pc">
  <form class="pc__form" data-coverage-form>
    <span class="pc__ic" aria-hidden="true"><Icon name="map-pin" size={18} /></span>
    <label for="coverage-postcode" class="sr-only">Postcode</label>
    <input id="coverage-postcode" name="postcode" type="text" placeholder="Postcode, e.g. M14 5RB" autocomplete="postal-code" />
    <button class="btn btn--red pc__btn" type="submit">Check</button>
  </form>
  <p class="pc__hint">Covered? We'll take you straight to booking.</p>
  <p class="pc__result" data-coverage-result role="status" hidden></p>
</div>

<script>
  import { initCoverageForms } from '@/scripts/coverage-check';
  initCoverageForms();
</script>

<style>
  .pc__form {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 16px;
    border-radius: var(--r-pill);
    background: var(--glass-light-bg);
    border: 1.5px solid var(--line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition: border-color 0.2s;
  }
  .pc__form:focus-within {
    border-color: var(--blue);
  }
  .pc__ic {
    flex: none;
    color: var(--red);
    display: grid;
  }
  .pc__form input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-size: 15px;
  }
  .pc__form input::placeholder {
    color: var(--muted);
  }
  .pc__btn {
    height: 44px;
    padding: 0 24px;
    font-size: 15px;
  }
  .pc__hint {
    margin: 10px 0 0;
    padding-left: 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .pc__result {
    margin: 10px 0 0;
    padding: 10px 14px;
    border-radius: var(--r-sm);
    background: var(--red-tint);
    color: var(--red-2);
    font-size: 14px;
    font-weight: 600;
  }
</style>
