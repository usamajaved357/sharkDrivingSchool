---
/**
 * Courses bento grid. Layout lives here; each tile style is its own component
 * in ./courses/ (photo feature, red intensive, small tiles, mock-tests banner).
 */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { courseTiles } from '@/data/courses';
import FeatureTile from './courses/FeatureTile.astro';
import IntensiveTile from './courses/IntensiveTile.astro';
import MockTestsBanner from './courses/MockTestsBanner.astro';
import SmallTile from './courses/SmallTile.astro';

const tiles = { feature: FeatureTile, 'wide-red': IntensiveTile, small: SmallTile, 'wide-paper': MockTestsBanner } as const;
---

<section id="courses" class="courses">
  <div class="wrap">
    <div class="courses__head">
      <SectionHeader eyebrow="Courses" title="A course for every kind of learner" />
      <a class="btn btn--blue reveal" href="/prices">See all courses &amp; prices</a>
    </div>

    <div class="bento">
      {
        courseTiles.map((t, i) => {
          const Tile = tiles[t.variant];
          return <Tile tile={t} style={`--reveal-delay:${(i % 4) * 0.08}s`} />;
        })
      }
    </div>
  </div>
</section>

<style>
  .courses {
    padding: clamp(32px, min(5vw, 5vh), 64px) 0 clamp(40px, min(6vw, 6vh), 72px);
  }
  .courses__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 4vh, 36px);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* Rows are at least 228px but grow if a tile's content needs more (e.g. narrower laptops). */
    /* Rows shrink a little on short screens so the whole grid fits one screen. */
    grid-auto-rows: minmax(clamp(164px, 22vh, 216px), auto);
    /* Two tile rows, then the full-width "mock tests" strip sized to its content. */
    grid-template-rows: minmax(clamp(164px, 22vh, 216px), auto) minmax(clamp(164px, 22vh, 216px), auto) auto;
    gap: 18px;
  }

  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      /* Let small tiles fill the space beside the tall "Beginner" tile on tablets. */
      grid-auto-flow: dense;
    }
  }
  /* Phones: big tiles span the full width, the four small course tiles sit two per row. */
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 12px;
    }
  }
</style>
