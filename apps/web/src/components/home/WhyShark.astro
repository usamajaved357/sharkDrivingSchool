---
import Icon from '@/components/ui/Icon.astro';
import { whyPhoto } from '@/data/home';
import { shownFeatures, shownLatestPass } from '@/data/shown-content';

// Full, uncropped photo at the requested width (the frame matches its 3:2 shape).
const photoUrl = (w: number) => `${whyPhoto.src}?w=${w}&q=75&auto=format`;
---

<section class="why bg-navy section-lg">
  <div class="why__dots" aria-hidden="true"></div>
  <div class="wrap split why__grid">
    <div class="why__media reveal">
      <img
        class="why__photo"
        src={photoUrl(900)}
        srcset={`${photoUrl(600)} 600w, ${photoUrl(900)} 900w, ${photoUrl(1300)} 1300w`}
        sizes="(max-width: 1000px) 100vw, 55vw"
        alt={whyPhoto.alt}
        width="900"
        height="600"
        loading="lazy"
        decoding="async"
      />
      {
        shownLatestPass && (
          <div class="why__toast">
            <span class="why__toast-ic">
              <Icon name="trophy" size={24} />
            </span>
            <div>
              <div class="why__toast-title">Another pass this week</div>
              <div class="why__toast-meta">
                {shownLatestPass.name} · {shownLatestPass.centre}
              </div>
            </div>
          </div>
        )
      }
    </div>

    <div>
      <div class="reveal">
        <span class="eyebrow why__eyebrow">Why Shark</span>
        <h2 class="d h-md why__title">Calm in the car. Ruthless about results.</h2>
        <p class="why__lead">
          Our instructors are patient with nerves and serious about getting you through the test. Every lesson has a goal, and you always
          know where you stand.
        </p>
      </div>
      <ul class="g2 why__features">
        {
          shownFeatures.map((f, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 0.06}s`}>
              <span class="ic why__ic">
                <Icon name={f.icon} size={22} />
              </span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    overflow: hidden;
  }
  .why__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .why__grid {
    position: relative;
  }
  .why__media {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    /* Same 3:2 shape as the photo, so both people stay fully in frame. */
    aspect-ratio: 3 / 2;
    background: repeating-linear-gradient(135deg, #0d2a60 0 18px, #0b2454 18px 36px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .why__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Darkens the bottom of the photo so the "Another pass" card stands out. */
  .why__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 20, 46, 0.7) 0%, rgba(6, 20, 46, 0) 45%);
    pointer-events: none;
  }
  .why__toast {
    z-index: 1;
  }
  .why__toast {
    position: absolute;
    left: 24px;
    bottom: 24px;
    right: 24px;
    background: var(--white);
    color: var(--ink);
    border-radius: var(--r-md);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .why__toast-ic {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .why__toast-title {
    font-weight: 800;
  }
  .why__toast-meta {
    font-size: 14px;
    color: var(--muted);
  }
  .why__eyebrow {
    color: #ff6a63;
  }
  .why__title {
    margin-top: 16px;
  }
  .why__lead {
    font-size: 18px;
    color: var(--on-dark-muted);
    line-height: 1.7;
    margin: 22px 0 0;
  }
  .why__features {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    gap: 28px;
  }
  .why__features li {
    display: flex;
    gap: 14px;
  }
  .why__ic {
    background: rgba(76, 141, 255, 0.16);
    color: var(--sky-soft);
    width: 46px;
    height: 46px;
    border-radius: 14px;
  }
  .why__features h3 {
    font-size: 17px;
    font-weight: 800;
  }
  .why__features p {
    margin: 4px 0 0;
    color: #afc0e2;
    font-size: 15px;
    line-height: 1.5;
  }
</style>
