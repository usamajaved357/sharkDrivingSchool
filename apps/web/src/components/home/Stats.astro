---
import { shownRating, shownStats } from '@/data/shown-content';
---

<section class="stats" aria-label="Shark Driving School in numbers">
  <div class="wrap g4 stats__grid">
    {
      shownStats.map((s, i) => (
        <div class="reveal" style={`--reveal-delay:${i * 0.1}s`}>
          {s.live === 'google' && shownRating ? (
            <>
              <div class:list={['d', 'stats__value', `stats__value--${s.tone}`]}>
                <span data-live-rating>{shownRating.rating}</span>★
              </div>
              <p class="stats__label">
                From <span data-live-count>{shownRating.count}</span> Google reviews
              </p>
            </>
          ) : (
            <>
              <div class:list={['d', 'stats__value', `stats__value--${s.tone}`]}>{s.value}</div>
              <p class="stats__label">{s.label}</p>
            </>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    padding: clamp(64px, 7vw, 88px) 0 24px;
  }
  .stats__value {
    font-size: clamp(44px, 4.2vw, 56px);
  }
  .stats__value--blue {
    color: var(--blue);
  }
  .stats__value--red {
    color: var(--red);
  }
  .stats__label {
    margin: 10px 0 0;
    font-weight: 600;
    color: var(--muted);
  }
  /* Phones: keep a compact 2×2 grid instead of four tall rows. */
  @media (max-width: 640px) {
    .stats {
      padding-top: 56px;
    }
    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
    .stats__value {
      font-size: clamp(32px, 10vw, 42px);
    }
    .stats__label {
      margin-top: 6px;
      font-size: 14px;
      line-height: 1.4;
    }
  }
</style>
