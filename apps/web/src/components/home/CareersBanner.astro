---
import Icon from '@/components/ui/Icon.astro';
import { telHref } from '@/config/site';
---

<section id="careers" class="section">
  <div class="wrap">
    <div class="careers reveal">
      <div aria-hidden="true" class="d careers__watermark">PACK</div>
      <div class="careers__body">
        <span class="eyebrow careers__eyebrow">Careers</span>
        <h2 class="d h-sm careers__title">Join the Shark pack</h2>
        <p class="careers__text">
          Qualified ADI or training to become one? Get a steady stream of learners and the backing of a growing Manchester brand.
        </p>
      </div>
      <!-- TODO: link to a dedicated /instructors page with an application form. -->
      <a class="btn btn--white careers__btn" href={telHref}>Become an instructor <Icon name="arrow-right" size={18} strokeWidth={2.4} /></a>
    </div>
  </div>
</section>

<style>
  .careers {
    background: var(--blue);
    border-radius: var(--r-2xl);
    padding: 64px;
    color: var(--white);
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .careers__watermark {
    position: absolute;
    right: -20px;
    bottom: -50px;
    font-size: 220px;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.15);
  }
  .careers__body {
    position: relative;
    max-width: 620px;
  }
  .careers__eyebrow {
    color: var(--white);
    opacity: 0.85;
  }
  .careers__title {
    margin-top: 14px;
  }
  .careers__text {
    font-size: 18px;
    line-height: 1.6;
    color: #dce7ff;
    margin: 16px 0 0;
  }
  .careers__btn {
    position: relative;
  }
  @media (max-width: 640px) {
    .careers {
      padding: 40px 28px;
    }
  }
</style>
