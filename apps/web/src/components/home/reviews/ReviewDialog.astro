---
/**
 * Pop-up with a review in full (opened by "Read full review" on a card; filled in by
 * scripts/review-cards.ts). Native <dialog>: Esc closes it and focus is kept inside.
 */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
---

<dialog class="rd" data-review-dialog aria-labelledby="rd-name">
  <div class="rd__box">
    <button class="rd__close" type="button" aria-label="Close review" data-review-close>
      <Icon name="close" size={20} />
    </button>
    <img class="rd__img" alt="" data-rd-img hidden />
    <div class="rd__body">
      <div class="rd__head">
        <GoogleLogo size={28} />
        <div>
          <p id="rd-name" class="rd__name" data-rd-name></p>
          <p class="rd__meta"><span class="rd__stars" data-rd-stars></span> <span data-rd-date></span></p>
        </div>
      </div>
      <p class="rd__text" data-rd-text></p>
      <a class="rd__link" href={site.google.reviewsUrl} target="_blank" rel="noopener">See all reviews on Google</a>
    </div>
  </div>
</dialog>

<style>
  .rd {
    padding: 0;
    border: 0;
    background: transparent;
    width: min(760px, calc(100vw - 32px));
    max-height: min(86vh, 720px);
    overflow: visible;
  }
  .rd::backdrop {
    background: rgba(6, 20, 46, 0.6);
    backdrop-filter: blur(3px);
  }
  .rd[open] {
    animation: rd-in 0.25s var(--ease-out);
  }
  @keyframes rd-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  .rd__box {
    position: relative;
    display: flex;
    max-height: min(86vh, 720px);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow-float);
  }
  .rd__img {
    width: 42%;
    flex: none;
    object-fit: cover;
    background: var(--paper);
  }
  .rd__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 28px 24px;
    overflow-y: auto;
  }
  .rd__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 36px;
  }
  .rd__name {
    margin: 0;
    font-weight: 800;
    font-size: 18px;
    color: var(--ink);
  }
  .rd__meta {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .rd__stars {
    color: var(--star);
    letter-spacing: 1px;
  }
  .rd__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    white-space: pre-line;
  }
  .rd__link {
    margin-top: auto;
    font-weight: 700;
    font-size: 14px;
  }
  .rd__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .rd__close:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  @media (max-width: 640px) {
    .rd__box {
      flex-direction: column;
    }
    .rd__img {
      width: 100%;
      height: 38vh;
    }
    .rd__body {
      padding: 22px 20px 20px;
    }
  }
</style>
