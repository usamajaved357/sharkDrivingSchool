---
/**
 * Google rating badge: "Excellent 5.0 ★★★★★", a stack of reviewer photos and the review
 * count, linking to the reviews on Google. Renders nothing while the rating is a placeholder.
 */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import { site } from '@/config/site';
import { shownRating, shownReviews } from '@/data/shown-content';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const faces = shownReviews.filter((r) => r.photo).slice(0, 4);
const word = (n: number) => (n >= 4.5 ? 'Excellent' : n >= 4 ? 'Great' : 'Good');
---

{
  shownRating && (
    <a
      class:list={['rb', cls]}
      href={site.google.reviewsUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Rated ${shownRating.rating} out of 5 from ${shownRating.count} Google reviews (opens Google)`}
    >
      <span class="rb__g">
        <GoogleLogo size={26} />
      </span>
      <span class="rb__main">
        <span class="rb__top">
          <b class="rb__word">{word(Number(shownRating.rating))}</b>
          <span class="rb__score">{shownRating.rating}</span>
          <span class="rb__stars" aria-hidden="true">
            ★★★★★
          </span>
        </span>
        <span class="rb__bottom">
          <span class="rb__faces" aria-hidden="true">
            {faces.map((r) => (
              <span class="rb__face">
                {r.name.charAt(0).toUpperCase()}
                <img src={r.photo} alt="" width="26" height="26" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </span>
            ))}
          </span>
          <span class="rb__count">
            {shownRating.count} reviews on Google <span aria-hidden="true">›</span>
          </span>
        </span>
      </span>
    </a>
  )
}

<style>
  .rb {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px 12px 12px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 16px 36px -26px rgba(6, 20, 46, 0.45);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .rb:hover {
    transform: translateY(-2px);
    border-color: var(--sky-soft);
    box-shadow: var(--shadow-card);
  }
  .rb__g {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--paper);
    display: grid;
    place-items: center;
  }
  .rb__main {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .rb__top {
    display: flex;
    align-items: baseline;
    gap: 7px;
    line-height: 1;
  }
  .rb__word {
    font-size: 16px;
    font-weight: 800;
  }
  .rb__score {
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
  }
  .rb__stars {
    color: var(--star);
    font-size: 16px;
    letter-spacing: 1px;
  }
  .rb__bottom {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .rb__faces {
    display: flex;
  }
  .rb__face {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--white);
    margin-left: -8px;
    background: var(--blue);
    color: var(--white);
    font-size: 11px;
    font-weight: 800;
    display: grid;
    place-items: center;
  }
  .rb__face:first-child {
    margin-left: 0;
  }
  .rb__face img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rb__count {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .rb:hover .rb__count {
    color: var(--blue);
  }
</style>
