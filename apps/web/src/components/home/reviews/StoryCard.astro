---
/**
 * One Google review in the "Learners who passed" rail. With a pass photo: the photo on top,
 * the learner's words underneath. Without one: their words on a navy quote panel, with their
 * Google profile photo underneath. "Read full review" opens ReviewDialog.astro
 * (scripts/review-cards.ts). Cards in a row share one height.
 * `live` renders an empty quote card used as a template for reviews fetched live from
 * Google (scripts/live-reviews.ts fills it in, with the author and Google Maps links Google requires).
 */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import Icon from '@/components/ui/Icon.astro';
import { passImage, passPhotos } from '@/data/passes';
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
  live?: boolean;
}
const { review: r, live = false } = Astro.props;
const img = r.passPhoto ? passImage(r.passPhoto) : null;
const alt = passPhotos.find((p) => p.slug === r.passPhoto)?.alt ?? `${r.name} after passing`;
const passed = r.tag?.startsWith('Passed first time') ? 'Passed first time' : r.tag?.startsWith('Passed') ? 'Passed' : null;
const stars = '★'.repeat(r.rating);
---

<li
  class:list={['sc', { 'sc--quote': !img }]}
  data-review
  data-name={r.name}
  data-stars={stars}
  data-date={r.date}
  data-img={img?.src}
  data-img-alt={img ? alt : undefined}
>
  <figure class="sc__card">
    {
      img ? (
        <div class="sc__media">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="(max-width: 640px) 76vw, 300px"
            width={img.width}
            height={img.height}
            alt={alt}
            loading="lazy"
            decoding="async"
          />
          <span class="sc__pass">
            <Icon name="check" size={14} strokeWidth={3} />
            {passed ?? 'Passed'}
          </span>
          <span class="sc__g" title="Google review">
            <GoogleLogo size={18} />
          </span>
        </div>
      ) : (
        <div class="sc__media sc__panel">
          <Icon name="quote" size={30} class="sc__q" />
          <blockquote class="sc__text sc__text--panel" data-review-text>{r.text}</blockquote>
          {passed && (
            <span class="sc__pass sc__pass--static">
              <Icon name="check" size={14} strokeWidth={3} />
              {passed}
            </span>
          )}
          {live ? (
            <a class="sc__g" data-review-maps target="_blank" rel="noopener" aria-label="View this review on Google Maps">
              <GoogleLogo size={18} />
            </a>
          ) : (
            <span class="sc__g" title="Google review">
              <GoogleLogo size={18} />
            </span>
          )}
        </div>
      )
    }
    <figcaption class="sc__body">
      {
        img ? (
          <>
            <span class="sc__name">{r.name}</span>
            <span class="sc__meta">
              <span class="sc__stars" role="img" aria-label={`${r.rating} out of 5 stars`}>{stars}</span>
              <span class="sc__date">{r.date}</span>
            </span>
            <blockquote class="sc__text" data-review-text>{r.text}</blockquote>
          </>
        ) : (
          <span class="sc__who">
            <span class="sc__avatar" aria-hidden="true">
              <span class="sc__initial">{r.name.charAt(0).toUpperCase()}</span>
              {(r.photo || live) && (
                <img src={r.photo} alt="" width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-review-photo />
              )}
            </span>
            <span>
              {live ? (
                <a class="sc__name" data-review-author target="_blank" rel="noopener" />
              ) : (
                <span class="sc__name">{r.name}</span>
              )}
              <span class="sc__meta">
                <span class="sc__stars" role="img" aria-label={`${r.rating} out of 5 stars`}>{stars}</span>
                <span class="sc__date">{r.date}</span>
              </span>
            </span>
          </span>
        )
      }
      <button class="sc__more" type="button" aria-expanded="false" data-review-more data-label="Read full review" hidden>
        Read full review
      </button>
    </figcaption>
  </figure>
</li>

<style>
  .sc {
    /* Height-aware so the whole section fits one laptop screen. */
    width: clamp(210px, 27vh, 290px);
    display: flex;
  }
  .sc__card {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 18px 40px -30px rgba(6, 20, 46, 0.4);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
  }
  .sc__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .sc__media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--paper);
  }
  .sc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Soft shade at the bottom of the photo so the badge reads on any background. */
  .sc__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 20, 46, 0.45), transparent 32%);
    pointer-events: none;
  }
  .sc__pass {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--success);
    color: var(--white);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .sc__g {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 12px rgba(6, 20, 46, 0.18);
  }
  .sc__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 16px;
    flex: 1;
  }
  a.sc__name {
    text-decoration: none;
  }
  a.sc__name:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .sc__name {
    font-weight: 800;
    font-size: 16px;
    color: var(--ink);
  }
  .sc__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .sc__stars {
    color: var(--star);
    font-size: 14px;
    letter-spacing: 1px;
  }
  .sc__meta {
    white-space: nowrap;
  }
  .sc--quote .sc__stars {
    font-size: 12px;
    letter-spacing: 0;
  }
  .sc__text {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .sc__more {
    align-self: flex-start;
    margin-top: auto;
    padding: 6px 0 0;
    border: 0;
    background: none;
    color: var(--blue);
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .sc__more:hover {
    text-decoration: underline;
  }
  /* Quote card (no pass photo): the words sit on a navy panel the same size as a photo. */
  .sc__panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 20px 18px;
    background:
      radial-gradient(220px 160px at 100% 0%, rgba(76, 141, 255, 0.28), transparent 70%),
      linear-gradient(160deg, var(--navy-2), var(--navy));
    color: var(--white);
  }
  .sc__panel::after {
    display: none;
  }
  .sc__panel :global(.sc__q) {
    flex: none;
    color: var(--sky);
  }
  .sc__text--panel {
    margin: 0;
    color: var(--white);
    font-size: 15px;
    line-height: 1.55;
    -webkit-line-clamp: 8;
    line-clamp: 8;
  }
  .sc__pass--static {
    position: static;
    align-self: flex-start;
    margin-top: auto;
  }
  .sc__who {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sc__who > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .sc__avatar {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: var(--white);
    font-weight: 800;
  }
  .sc__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 640px) {
    .sc {
      width: 76%;
    }
  }
</style>
