---
/**
 * A "pass story": the learner's own pass photo from their Google review, with their name,
 * stars and words underneath. Behaviour (read full review): scripts/review-cards.ts.
 */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import Icon from '@/components/ui/Icon.astro';
import { passImage, passPhotos } from '@/data/passes';
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
}
const { review: r } = Astro.props;
const img = r.passPhoto ? passImage(r.passPhoto) : null;
const alt = passPhotos.find((p) => p.slug === r.passPhoto)?.alt ?? `${r.name} after passing`;
---

<li class="sc" data-review>
  <figure class="sc__card">
    {
      img && (
        <div class="sc__media">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="(max-width: 640px) 76vw, 300px"
            width={img.width}
            height={img.height}
            alt={alt}
            loading="lazy"
            decoding="async"
          />
          <span class="sc__pass">
            <Icon name="check" size={14} strokeWidth={3} />
            {r.tag?.startsWith('Passed first time') ? 'Passed first time' : 'Passed'}
          </span>
          <span class="sc__g" title="Google review">
            <GoogleLogo size={18} />
          </span>
        </div>
      )
    }
    <figcaption class="sc__body">
      <span class="sc__name">{r.name}</span>
      <span class="sc__meta">
        <span class="sc__stars" role="img" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</span>
        {r.date}
      </span>
      <blockquote class="sc__text" data-review-text>{r.text}</blockquote>
      <button class="sc__more" type="button" aria-expanded="false" data-review-more data-label="Read full review" hidden>
        Read full review
      </button>
    </figcaption>
  </figure>
</li>

<style>
  .sc {
    /* Height-aware so the whole section fits one laptop screen. */
    width: clamp(220px, 31vh, 290px);
    display: flex;
  }
  .sc__card {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 18px 40px -30px rgba(6, 20, 46, 0.4);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
  }
  .sc__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .sc__media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--paper);
  }
  .sc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Soft shade at the bottom of the photo so the badge reads on any background. */
  .sc__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 20, 46, 0.45), transparent 32%);
    pointer-events: none;
  }
  .sc__pass {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--success);
    color: var(--white);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .sc__g {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 12px rgba(6, 20, 46, 0.18);
  }
  .sc__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 16px;
    flex: 1;
  }
  .sc__name {
    font-weight: 800;
    font-size: 16px;
    color: var(--ink);
  }
  .sc__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .sc__stars {
    color: var(--star);
    font-size: 14px;
    letter-spacing: 1px;
  }
  .sc__text {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .sc__text.is-open {
    display: block;
  }
  .sc__more {
    align-self: flex-start;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--blue);
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .sc__more:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .sc {
      width: 76%;
    }
  }
</style>
