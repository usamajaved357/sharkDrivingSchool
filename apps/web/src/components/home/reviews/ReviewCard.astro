---
/** One Google review (text card) in the Google reviews rail. Behaviour: scripts/review-cards.ts. */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
  /** Avatar colour when the photo can't load. */
  tone: 'red' | 'blue' | 'navy';
}
const { review: r, tone } = Astro.props;
const initial = r.name.trim().charAt(0).toUpperCase();
const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
---

<li class="rc" data-review>
  <figure class="rc__card">
    <figcaption class="rc__by">
      <span class:list={['rc__avatar', `rc__avatar--${tone}`]} aria-hidden="true">
        {initial}
        {r.photo && <img src={r.photo} alt="" width="44" height="44" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-review-photo />}
      </span>
      <span class="rc__who">
        <span class="rc__name">{r.name}</span>
        <span class="rc__date">{r.date} · Google review</span>
      </span>
      <span class="rc__g"><GoogleLogo size={20} /></span>
    </figcaption>

    <div class="rc__rating">
      <span class="rc__stars" role="img" aria-label={`${r.rating} out of 5 stars`}>{stars}</span>
      {r.tag && <span class="rc__tag">{r.tag}</span>}
    </div>

    <blockquote class="rc__text" data-review-text>{r.text}</blockquote>
    <button class="rc__more" type="button" aria-expanded="false" data-review-more hidden>Read more</button>
  </figure>
</li>

<style>
  .rc {
    width: clamp(280px, 30vw, 372px);
    display: flex;
  }
  .rc__card {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 18px 40px -30px rgba(6, 20, 46, 0.35);
  }
  .rc__by {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rc__avatar {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    color: var(--white);
    font-weight: 800;
    font-size: 18px;
  }
  .rc__avatar--red {
    background: var(--red);
  }
  .rc__avatar--blue {
    background: var(--blue);
  }
  .rc__avatar--navy {
    background: var(--navy);
  }
  .rc__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rc__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .rc__name {
    font-weight: 800;
    font-size: 16px;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rc__date {
    font-size: 13px;
    color: var(--muted);
  }
  .rc__g {
    flex: none;
    align-self: flex-start;
  }
  .rc__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .rc__stars {
    color: var(--star);
    font-size: 18px;
    letter-spacing: 2px;
  }
  .rc__tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--success);
    background: var(--success-bg);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .rc__text {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }
  .rc__text.is-open {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
  }
  .rc__more {
    align-self: flex-start;
    margin-top: -4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--blue);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .rc__more:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .rc {
      width: 84%;
    }
    .rc__card {
      padding: 20px;
    }
  }
</style>
