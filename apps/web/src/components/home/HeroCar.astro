---
/**
 * A car at night on the hero road: a faint dark body, glowing lights with bloom and
 * their reflection on the road. "rear" = red tail-lights (driving away),
 * "front" = headlights with beams (coming towards you). Purely decorative.
 */
interface Props {
  view: 'rear' | 'front';
  class?: string;
}
const { view, class: className } = Astro.props;
---

<span class:list={['nc', `nc--${view}`, className]} aria-hidden="true">
  {view === 'front' && <span class="nc__beam" />}
  <span class="nc__reflection"></span>
  <span class="nc__body">
    <span class="nc__roof"></span>
  </span>
  <span class="nc__light nc__light--l"></span>
  <span class="nc__light nc__light--r"></span>
</span>

<style>
  .nc {
    --glow: var(--red);
    display: block;
  }
  .nc--front {
    --glow: var(--white);
  }

  /* Dark body: just enough shape to read as a car around the lights. */
  .nc__body {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 36%;
    bottom: 14%;
    border-radius: 14px 14px 8px 8px;
    background: linear-gradient(180deg, rgba(40, 60, 100, 0.95), rgba(6, 20, 46, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 6px 10px rgba(0, 0, 0, 0.5);
  }
  .nc__roof {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 92%;
    height: 70%;
    border-radius: 16px 16px 4px 4px;
    background: linear-gradient(180deg, rgba(60, 85, 135, 0.9), rgba(10, 31, 74, 0.95));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  /* Lights with bloom */
  .nc__light {
    position: absolute;
    top: 50%;
    width: 20%;
    height: 9%;
    border-radius: 40%;
    background: var(--glow);
    box-shadow:
      0 0 6px 2px var(--glow),
      0 0 18px 6px var(--glow);
    opacity: 0.95;
  }
  .nc--rear .nc__light {
    box-shadow:
      0 0 6px 2px rgba(225, 6, 0, 0.9),
      0 0 22px 8px rgba(225, 6, 0, 0.55);
  }
  .nc--front .nc__light {
    background: var(--white);
    box-shadow:
      0 0 8px 3px rgba(255, 255, 255, 0.95),
      0 0 30px 12px rgba(200, 220, 255, 0.6);
  }
  .nc__light--l {
    left: 12%;
  }
  .nc__light--r {
    right: 12%;
  }

  /* Light spilling onto the road under the car */
  .nc__reflection {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 16%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent);
    opacity: 0.35;
    filter: blur(3px);
  }
  /* Headlight beams fanning out towards the viewer */
  .nc__beam {
    position: absolute;
    left: -30%;
    right: -30%;
    top: 55%;
    height: 140%;
    background: radial-gradient(60% 70% at 50% 0%, rgba(220, 232, 255, 0.45), transparent 70%);
    filter: blur(4px);
  }
</style>
