---
/**
 * Hero "Find your instructor" card. Submits as a GET to /book so the enquiry
 * form opens with gearbox, interest and postcode prefilled.
 */
import Fin from '@/components/ui/Fin.astro';
import SegmentedToggle from '@/components/ui/SegmentedToggle.astro';
import { whatsappHref } from '@/config/site';
import { bookableLessons } from '@/data/pricing';
---

<div class="rise dl3 qbc">
  <Fin width={96} layered class="fin-bob qbc__fin" />
  <form class="qbc__card" action="/book" method="get" data-quick-booking>
    <div class="qbc__head">
      <div>
        <h2 class="qbc__title">Find your instructor</h2>
        <p class="qbc__sub">Tell us where you are and we'll call you back.</p>
      </div>
      <span class="qbc__chip">Free pick-up</span>
    </div>

    <SegmentedToggle group="hero-trans" label="Transmission" variant="dark" class="qbc__seg" />
    <input type="hidden" name="transmission" value="manual" />

    <div class="qbc__fields">
      <div class="field">
        <label for="qbc-postcode">Your postcode</label>
        <input id="qbc-postcode" name="postcode" type="text" placeholder="e.g. M14 5RB" autocomplete="postal-code" />
      </div>
      <div class="field">
        <label for="qbc-lesson">What do you need?</label>
        <select id="qbc-lesson" name="lesson">
          {bookableLessons.map((l) => <option value={l.id}>{l.name}</option>)}
        </select>
      </div>
      <button class="btn btn--red btn--block qbc__submit" type="submit">
        <span>Get started · <span data-bind-group="hero-trans" data-text-manual="Manual" data-text-automatic="Automatic">Manual</span></span>
      </button>
      <p class="qbc__alt">Prefer to chat? <a href={whatsappHref}>WhatsApp us</a></p>
    </div>
  </form>
</div>

<script>
  import { SEGMENTED_EVENT, type SegmentedChangeDetail } from '@/scripts/segmented';
  const form = document.querySelector<HTMLFormElement>('[data-quick-booking]');
  form?.addEventListener(SEGMENTED_EVENT, (e) => {
    const { value } = (e as CustomEvent<SegmentedChangeDetail>).detail;
    const hidden = form.querySelector<HTMLInputElement>('input[name="transmission"]');
    if (hidden) hidden.value = value;
  });
</script>

<style>
  .qbc {
    position: relative;
  }
  .qbc :global(.qbc__fin) {
    position: absolute;
    right: 28px;
    top: -50px;
    z-index: 0;
  }
  /* Liquid glass card: the hero (fin, watermark, glow) shows through, frosted. */
  .qbc__card {
    position: relative;
    z-index: 1;
    background: var(--glass-dark-bg);
    border: 1px solid var(--glass-dark-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--white);
    border-radius: var(--r-xl);
    padding: 28px 30px 26px;
    box-shadow: var(--glass-highlight), var(--shadow-float);
  }
  .qbc__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .qbc__title {
    font-size: 22px;
    font-weight: 800;
  }
  .qbc__sub {
    margin: 4px 0 0;
    color: var(--on-dark-muted);
    font-size: 14px;
  }
  .qbc__chip {
    background: var(--success-bg);
    color: var(--success);
    font-size: 12px;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .qbc :global(.qbc__seg) {
    margin-top: 18px;
  }
  .qbc :global(.seg) {
    height: 40px;
  }
  .qbc__fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .qbc__fields :global(label) {
    color: var(--on-dark-muted);
  }
  /* Glass inputs */
  .qbc__fields :global(input),
  .qbc__fields :global(select) {
    height: 46px;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--glass-dark-border);
    color: var(--white);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .qbc__fields :global(select) {
    background-image: var(--select-arrow-light);
  }
  .qbc__fields :global(option) {
    color: var(--ink);
  }
  .qbc__fields :global(input::placeholder) {
    color: rgba(255, 255, 255, 0.5);
  }
  .qbc__fields :global(input:focus),
  .qbc__fields :global(select:focus) {
    border-color: var(--sky);
    background-color: rgba(255, 255, 255, 0.12);
  }
  .qbc__submit {
    margin-top: 4px;
    height: 50px;
  }
  .qbc__alt {
    margin: 0;
    text-align: center;
    font-size: 14px;
    color: var(--on-dark-muted);
  }
  .qbc__alt a {
    font-weight: 700;
    color: var(--sky-soft);
  }
  @media (max-width: 640px) {
    .qbc__card {
      padding: 24px;
    }
    .qbc__submit {
      white-space: normal;
    }
  }
</style>
