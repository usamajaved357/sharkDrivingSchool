---
/**
 * "Learners who passed": the learners' own pass photos from their Google reviews, with their
 * words (data/reviews.ts + data/passes.ts), the live Google rating and a note about the
 * former name. The full written reviews follow in GoogleReviews.astro.
 */
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import RailNav from '@/components/ui/RailNav.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/config/site';
import { hasReviews, shownRating, shownReviews } from '@/data/shown-content';
import StoryCard from './reviews/StoryCard.astro';

const stories = shownReviews.filter((r) => r.passPhoto);
---

{
  hasReviews && stories.length > 0 && (
    <section id="reviews" class="section-lg st" data-carousel>
      <div class="wrap">
        <div class="st__head">
          <SectionHeader eyebrow="Google reviews" title="Learners who passed">
            <p class="st__former">
              Real learners, real passes. Some mention <b>{site.formerName}</b>: that's us, same instructors, new name.
            </p>
          </SectionHeader>
          <div class="st__side reveal">
            {shownRating && (
              <a class="card st__badge" href={site.google.reviewsUrl} target="_blank" rel="noopener" aria-label={`Rated ${shownRating.rating} out of 5 from ${shownRating.count} Google reviews (opens Google)`}>
                <GoogleLogo size={30} />
                <span>
                  <span class="st__score">
                    {shownRating.rating} <span class="st__stars">★★★★★</span>
                  </span>
                  <span class="st__count">{shownRating.count} reviews on Google</span>
                </span>
              </a>
            )}
            <RailNav label="pass stories" class="hide-sm" />
          </div>
        </div>

        <div class="rail st__rail reveal">
          <ul class="rail__track" data-carousel-track aria-label="Pass stories from Google reviews" tabindex="0">
            {stories.map((r) => <StoryCard review={r} />)}
          </ul>
        </div>
      </div>
    </section>
  )
}

<script>
  import { initCarousels } from '@/scripts/carousel';
  import { initReviewCards } from '@/scripts/review-cards';
  initCarousels();
  initReviewCards();
</script>

<style>
  .st__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 24px;
    flex-wrap: wrap;
  }
  .st__former {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .st__former b {
    color: var(--ink);
  }
  .st__side {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .st__badge {
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .st__badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .st__badge > span {
    display: flex;
    flex-direction: column;
  }
  .st__score {
    font-weight: 800;
    font-size: 19px;
  }
  .st__stars {
    color: var(--star);
  }
  .st__count {
    font-size: 13.5px;
    color: var(--muted);
  }
  .st__rail {
    margin-top: clamp(24px, 4vh, 36px);
  }
  @media (max-width: 640px) {
    .st__side {
      width: 100%;
    }
  }
</style>
