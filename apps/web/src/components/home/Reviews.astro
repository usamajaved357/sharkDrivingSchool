---
/**
 * "Learners who passed": the learners' own pass photos from their Google reviews, with their
 * words (data/reviews.ts + data/passes.ts), the live Google rating, a note about the former
 * name, and links to read every review or leave one on Google. Every review appears once:
 * cards with a pass photo first, then written reviews as quote cards.
 */
import RailNav from '@/components/ui/RailNav.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/config/site';
import { hasReviews, shownReviews } from '@/data/shown-content';
import RatingBadge from './reviews/RatingBadge.astro';
import ReviewDialog from './reviews/ReviewDialog.astro';
import StoryCard from './reviews/StoryCard.astro';

// Pass photos first, then the written reviews; every review appears once.
const stories = [...shownReviews.filter((r) => r.passPhoto), ...shownReviews.filter((r) => !r.passPhoto)];
---

{
  hasReviews && stories.length > 0 && (
    <section id="reviews" class="section-lg st" data-carousel>
      <div class="wrap">
        <div class="st__head">
          <SectionHeader eyebrow="Google reviews" title="Learners who passed">
            <p class="st__former">
              Real learners, real passes. Some mention <b>{site.formerName}</b>: that's us, same instructors, new name.
            </p>
          </SectionHeader>
          <div class="st__side reveal">
            <RatingBadge />
            <a class="st__write" href={site.google.writeReviewUrl} target="_blank" rel="noopener">
              Learned with us? Leave a review
            </a>
            <p class="st__live" data-live-note hidden>Includes the latest reviews from Google Maps, most relevant first.</p>
          </div>
        </div>

        <div class="rail st__rail reveal">
          <ul class="rail__track" data-carousel-track aria-label="Pass stories from Google reviews" tabindex="0">
            {stories.map((r) => <StoryCard review={r} />)}
          </ul>
          <RailNav label="pass stories" />
        </div>
      </div>
      <ReviewDialog />
      {/* Empty card for reviews fetched live from Google (scripts/live-reviews.ts). */}
      <template data-live-review-template>
        <StoryCard review={{ name: '', date: '', text: '', rating: 5 }} live />
      </template>
    </section>
  )
}

<script>
  import { initCarousels } from '@/scripts/carousel';
  import { initLiveReviews } from '@/scripts/live-reviews';
  import { initReviewCards } from '@/scripts/review-cards';
  initCarousels();
  initReviewCards();
  initLiveReviews();
</script>

<style>
  .st__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 24px;
    flex-wrap: wrap;
  }
  .st__former {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .st__former b {
    color: var(--ink);
  }
  .st__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .st__live {
    margin: 0;
    padding-right: 12px;
    font-size: 12px;
    color: var(--muted);
  }
  .st__write {
    font-size: 14px;
    font-weight: 700;
    padding-right: 12px;
  }
  @media (max-width: 640px) {
    .st__side {
      align-items: flex-start;
    }
    .st__live {
    margin: 0;
    padding-right: 12px;
    font-size: 12px;
    color: var(--muted);
  }
  .st__write {
      padding: 0 0 0 4px;
    }
  }
  .st__rail {
    margin-top: clamp(20px, 3vh, 36px);
  }
</style>
