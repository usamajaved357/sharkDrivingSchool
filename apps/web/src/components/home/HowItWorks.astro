---
/**
 * "How it works" as a road journey. When the section scrolls into view (.reveal → .is-visible),
 * a car drives along the road, a red→blue trail fills behind it, and each step lights up
 * as the car reaches it (timing via --start, --drive and each step's --at).
 * Desktop: horizontal road. Tablet/phone: vertical rail.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { steps } from '@/data/home';
import HowStep from './how/HowStep.astro';
---

<section class="how section-lg">
  <div class="wrap">
    <div class="how__head">
      <SectionHeader eyebrow="How it works" title="From provisional to pass in 4 moves" />
      <a class="btn btn--red reveal" href="/book">Start with step 1 <Icon name="arrow-right" size={18} strokeWidth={2.4} /></a>
    </div>

    <div class="how__journey reveal">
      <div class="how__road" aria-hidden="true">
        <span class="how__lane"></span>
        <span class="how__trail"></span>
        <span class="how__drive"><span class="how__car"><Icon name="car" size={22} strokeWidth={2} /></span></span>
        <span class="how__flag"><Icon name="flag" size={18} strokeWidth={2.2} /></span>
      </div>
      <ol class="how__steps">
        {steps.map((s, i) => <HowStep step={s} at={i / steps.length} />)}
      </ol>
    </div>
  </div>
</section>

<style>
  .how {
    background: radial-gradient(900px 400px at 85% 0%, rgba(76, 141, 255, 0.08), transparent 70%), var(--white);
  }
  .how__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .how__journey {
    --start: 0.3s;
    --drive: 3.2s;
    position: relative;
    margin-top: 56px;
  }
  /* Keep the journey container itself still; its children do the animating. */
  .how__journey:global(.reveal) {
    translate: none;
    opacity: 1;
  }

  /* Road: from the first marker's centre to the finish flag. */
  .how__road {
    position: absolute;
    left: 36px;
    right: 20px;
    top: 29px;
    height: 14px;
    border-radius: var(--r-pill);
    background: var(--paper);
    box-shadow: inset 0 1px 3px rgba(6, 20, 46, 0.12);
  }
  .how__lane {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: repeating-linear-gradient(90deg, rgba(6, 20, 46, 0.18) 0 14px, transparent 14px 26px);
  }
  .how__trail {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--red), var(--blue));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--drive) linear var(--start);
  }
  /* Moving centre-line on the filled road. */
  .how__trail::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.85) 0 14px, transparent 14px 26px);
    animation: how-lane 0.8s linear infinite;
  }
  /* Full-width carrier moved with transform (same smooth track as the trail),
     so the car and the trail stay in step. The car sits at its right end. */
  .how__drive {
    position: absolute;
    z-index: 2;
    inset: 0;
    transform: translateX(calc(-100% + 48px));
    transition: transform var(--drive) linear var(--start);
  }
  .how__car {
    position: absolute;
    top: 50%;
    left: calc(100% - 48px);
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--glass-sheen), var(--red);
    box-shadow: 0 10px 22px -8px rgba(225, 6, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }
  .how__car :global(svg) {
    animation: how-bump 0.35s ease-in-out infinite alternate;
  }
  .how__flag {
    position: absolute;
    z-index: 1;
    right: -20px;
    top: 50%;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--glass-sheen), var(--navy);
    box-shadow: 0 0 0 6px var(--white);
  }
  :global(.is-visible) > .how__road .how__trail,
  :global(.no-js) .how__trail {
    transform: none;
  }
  :global(.is-visible) > .how__road .how__drive,
  :global(.no-js) .how__drive {
    transform: none;
  }
  :global(.is-visible) > .how__road .how__flag {
    animation: pop 0.5s var(--ease-out) calc(var(--start) + var(--drive)) both;
  }

  .how__steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  @keyframes how-lane {
    to {
      background-position: 26px 0;
    }
  }
  @keyframes how-bump {
    to {
      transform: translateY(-1.5px);
    }
  }

  /* Tablet/phone: vertical rail down the marker column; no car or flag. */
  @media (max-width: 1000px) {
    .how__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .how__road {
      left: 29px;
      right: auto;
      top: 36px;
      bottom: 36px;
      width: 14px;
      height: auto;
    }
    .how__lane,
    .how__drive,
    .how__flag {
      display: none;
    }
    .how__trail {
      background: linear-gradient(180deg, var(--red), var(--blue));
      transform: scaleY(0);
      transform-origin: top;
    }
    .how__trail::after {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .how__road {
      left: 22px;
      top: 28px;
      bottom: 28px;
      width: 12px;
    }
  }
</style>
