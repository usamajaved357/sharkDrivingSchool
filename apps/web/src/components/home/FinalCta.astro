---
import Fin from '@/components/ui/Fin.astro';
import { site, telHref } from '@/config/site';
---

<section class="cta">
  <div class="cta__waterline" aria-hidden="true"></div>
  <Fin width={90} color="var(--navy)" class="cta__fin" />
  <div class="wrap cta__body reveal">
    <h2 class="d h-lg">Ready to hit the road?</h2>
    <p class="cta__text">Book your first lesson today. Spaces fill fast in your area.</p>
    <div class="cta__actions">
      <a class="btn btn--white-red" href="/book">Book a lesson</a>
      <a class="btn btn--navy" href={telHref}>Call {site.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--red);
    color: var(--white);
    padding: clamp(72px, 8vw, 96px) 0 clamp(80px, 9vw, 104px);
    position: relative;
    overflow: hidden;
  }
  .cta__waterline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    height: 2px;
    background: rgba(255, 255, 255, 0.35);
  }
  .cta :global(.cta__fin) {
    position: absolute;
    left: 0;
    bottom: 34px;
    animation: swim 14s linear infinite;
  }
  .cta__body {
    text-align: center;
    position: relative;
  }
  /* Desktop: red section + footer fill exactly one screen at the bottom of the page,
     so nothing from the section above peeks in at the top. */
  @media (min-width: 1001px) and (min-height: 700px) {
    .cta {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--footer-h));
    }
    .cta__body {
      width: 100%;
    }
  }
  .cta__text {
    font-size: 20px;
    color: var(--red-tint);
    margin: 20px auto 0;
    max-width: 600px;
    line-height: 1.6;
  }
  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
</style>
