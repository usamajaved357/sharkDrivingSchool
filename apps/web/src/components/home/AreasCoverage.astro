---
/** "Areas we cover": copy, quick benefits and area chips beside the coverage map (./areas/). */
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { areaPerks, areas } from '@/data/areas';
import CoverageMap from './areas/CoverageMap.astro';
---

<section id="areas" class="bg-paper section-lg areas">
  <div class="wrap areas__grid">
    <div class="reveal">
      <span class="eyebrow eyebrow--dash">Areas we cover</span>
      <h2 class="d h-md areas__title">Lessons across {site.region}</h2>
      <p class="lead areas__lead">We pick you up from home, work, college or uni, and you learn on the same roads you will be tested on.</p>

      <ul class="areas__perks">
        {
          areaPerks.map((p) => (
            <li>
              <span class="areas__perk-ic">
                <Icon name={p.icon} size={18} />
              </span>
              {p.label}
            </li>
          ))
        }
      </ul>

      <p class="areas__chips-title">Popular pick-up areas</p>
      <ul class="areas__chips">
        {
          areas.map((a) => (
            <li>
              <a class="chip areas__chip" href="/book">
                <Icon name="map-pin" size={14} strokeWidth={2.4} />
                {a}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="areas__more">Not listed? Most of {site.region} is covered, so check your postcode on the map.</p>
    </div>

    <CoverageMap />
  </div>
</section>

<style>
  .areas__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .areas__title {
    margin-top: 16px;
  }
  .areas__lead {
    max-width: 520px;
  }
  .areas__perks {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .areas__perks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
  }
  .areas__perk-ic {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--glass-sheen), var(--blue);
    color: var(--white);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .areas__chips-title {
    margin: 32px 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .areas__chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .areas__chip {
    gap: 6px;
    height: 38px;
    padding: 0 14px;
    font-size: 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 2px 6px -4px rgba(6, 20, 46, 0.3);
  }
  .areas__chip :global(svg) {
    color: var(--red);
    transition: color 0.2s;
  }
  .areas__chip:hover :global(svg) {
    color: var(--white);
  }
  .areas__more {
    margin: 18px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .areas__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
