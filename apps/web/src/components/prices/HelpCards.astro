---
import { mailtoHref, site, telHref } from '@/config/site';
---

<section class="section">
  <div class="wrap help">
    <div class="help__card help__card--navy reveal">
      <h2 class="d help__title">Not sure what you need?</h2>
      <p>Book a single assessment lesson. Your instructor will recommend the right course and give you an honest hour estimate.</p>
      <a class="btn btn--red" href="/book?lesson=single">Book an assessment</a>
    </div>
    <div class="help__card help__card--red reveal" style="--reveal-delay:.1s">
      <h2 class="d help__title">Buying as a gift?</h2>
      <p>Gift vouchers for any lesson or block — perfect for a 17th birthday.</p>
      <a class="btn btn--white-red" href={telHref}>Call {site.phone.display}</a>
      <p class="help__alt">Or email <a href={mailtoHref}>{site.email}</a></p>
    </div>
  </div>
</section>

<style>
  .help {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .help__card {
    border-radius: var(--r-xl);
    padding: 40px;
    color: var(--white);
  }
  .help__card--navy {
    background: var(--navy);
  }
  .help__card--red {
    background: var(--red);
  }
  .help__title {
    font-size: 38px;
  }
  .help__card p {
    line-height: 1.6;
    font-size: 17px;
    margin: 16px 0 28px;
  }
  .help__card .help__alt {
    margin: 18px 0 0;
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .help__alt a {
    color: var(--white);
    font-weight: 700;
  }
  .help__card--navy p {
    color: var(--on-dark-muted);
  }
  .help__card--red p {
    color: var(--red-tint);
  }
  @media (max-width: 640px) {
    .help__card {
      padding: 32px 24px;
    }
  }
</style>
