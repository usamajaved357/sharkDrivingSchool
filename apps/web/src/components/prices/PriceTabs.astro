---
import GearboxText from '@/components/ui/GearboxText.astro';
import { site, telHref } from '@/config/site';
import { priceCategories } from '@/data/pricing';

const initial = 'blocks';
// Which booking-wizard lesson type each tab's "Book" button preselects.
const lessonFor: Record<string, string> = { payg: 'single', blocks: 'block-10', intensive: 'intensive', extras: 'pass-plus' };
---

<section class="pt">
  <div class="wrap">
    <div class="pt__panel" data-tabs>
      <div role="tablist" aria-label="Course type" class="pt__tabs">
        {
          priceCategories.map((c) => (
            <button
              type="button"
              role="tab"
              class="pt__tab"
              id={`tab-${c.id}`}
              data-tab={c.id}
              aria-controls={`panel-${c.id}`}
              aria-selected={c.id === initial ? 'true' : 'false'}
              tabindex={c.id === initial ? 0 : -1}
            >
              {c.label}
            </button>
          ))
        }
      </div>

      {
        priceCategories.map((c) => (
          <div role="tabpanel" id={`panel-${c.id}`} data-panel={c.id} aria-labelledby={`tab-${c.id}`} hidden={c.id !== initial}>
            <p class="pt__intro">{c.intro}</p>
            <div class="pt__rows">
              {c.rows.map((r) => (
                <div class:list={['pt__row', { 'pt__row--best': r.best }]}>
                  <div>
                    <div class="pt__name-line">
                      <h3 class="pt__name">{r.name}</h3>
                      {r.best && <span class="badge pt__best">BEST VALUE</span>}
                    </div>
                    <p class="pt__desc">{r.desc}</p>
                  </div>
                  <div class="pt__hours">
                    <b>{r.hours}</b>
                    <br />
                    <span data-bind-group="prices-trans" data-text-manual="Manual car" data-text-automatic="Automatic car">
                      Manual car
                    </span>
                  </div>
                  <div>
                    <GearboxText class="d pt__price" group="prices-trans" value={r.price} />
                    <div class="pt__per">
                      <GearboxText group="prices-trans" value={r.per} />
                    </div>
                  </div>
                  <a class="btn btn--red btn--sm" href={`/book?lesson=${lessonFor[c.id]}`}>
                    Book
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <p class="pt__note">
        Prices still marked [XX] are being confirmed. Call <a href={telHref}>{site.phone.display}</a> for a quote.
      </p>
    </div>
  </div>
</section>

<script>
  import { initTabs } from '@/scripts/tabs';
  initTabs();
</script>

<style>
  .pt {
    padding: 0 0 100px;
    margin-top: -50px;
    position: relative;
  }
  .pt__panel {
    background: var(--white);
    border-radius: var(--r-xl);
    padding: 36px;
    box-shadow: 0 40px 80px -40px rgba(6, 20, 46, 0.35);
    border: 1px solid var(--line);
  }
  .pt__tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pt__tab {
    height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    border: 1.5px solid var(--line);
    background: var(--white);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pt__tab[aria-selected='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .pt__intro {
    margin: 22px 0 26px;
    color: var(--muted);
    font-size: 16px;
  }
  .pt__rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  [role='tabpanel']:not([hidden]) .pt__row {
    animation: rise 0.5s var(--ease-out) both;
  }
  .pt__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.8fr auto;
    gap: 24px;
    align-items: center;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .pt__row:hover {
    transform: translateX(6px);
    box-shadow: 0 20px 40px -24px rgba(6, 20, 46, 0.3);
  }
  .pt__row--best {
    border: 2px solid var(--red);
  }
  .pt__name-line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pt__name {
    font-size: 20px;
    font-weight: 800;
  }
  .pt__best {
    font-size: 11px;
    padding: 5px 10px;
  }
  .pt__desc {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  .pt__hours {
    font-size: 15px;
    color: var(--muted);
  }
  .pt__hours b {
    color: var(--ink);
  }
  .pt__row :global(.pt__price) {
    font-size: 40px;
  }
  .pt__per {
    font-size: 13px;
    color: var(--muted);
  }
  .pt__note {
    margin: 24px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .pt__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .pt__panel {
      padding: 24px;
    }
    .pt__row {
      grid-template-columns: 1fr;
    }
  }
</style>
