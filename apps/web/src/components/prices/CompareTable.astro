---
import { weeklyVsIntensive } from '@/data/pricing';
---

<section class="bg-paper section">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">Compare</span>
      <h2 class="d h-md cmp__title">Weekly lessons vs intensive</h2>
    </div>
    <div class="cmp reveal">
      <table>
        <thead>
          <tr>
            <td></td>
            <th scope="col">Weekly lessons</th>
            <th scope="col" class="cmp__hl">Intensive course</th>
          </tr>
        </thead>
        <tbody>
          {
            weeklyVsIntensive.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td data-label="Weekly lessons">{r.weekly}</td>
                <td data-label="Intensive course" class="cmp__int">
                  <b>{r.intensive}</b>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cmp__title {
    margin: 14px 0 40px;
  }
  .cmp {
    overflow-x: auto;
    background: var(--white);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 16px;
    min-width: 560px;
  }
  th,
  td {
    padding: 18px 22px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  thead .cmp__hl {
    color: var(--red);
  }
  tbody th {
    font-weight: 700;
  }

  /* Phones: each row becomes a small card (label, then weekly vs intensive), no sideways scroll. */
  @media (max-width: 600px) {
    .cmp__title {
      margin-bottom: 24px;
    }
    .cmp {
      overflow: visible;
    }
    table {
      min-width: 0;
      font-size: 15px;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    tbody tr {
      display: block;
      padding: 16px 18px;
      border-bottom: 1px solid var(--line);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody th,
    tbody td {
      display: grid;
      grid-template-columns: 7.5em 1fr;
      gap: 12px;
      padding: 4px 0;
      border: 0;
    }
    tbody th {
      display: block;
      padding-bottom: 8px;
      font-size: 16px;
    }
    tbody td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      padding-top: 2px;
    }
    tbody .cmp__int::before {
      color: var(--red);
    }
  }
</style>
