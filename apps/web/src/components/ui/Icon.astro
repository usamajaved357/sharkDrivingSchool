---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Accessible label. Omit for decorative icons (default). */
  label?: string;
}

const { name, size = 20, strokeWidth = 2.2, class: className, label } = Astro.props;
const icon: { body: string; filled?: boolean } = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={icon.body}
/>
