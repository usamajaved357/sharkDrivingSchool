---
/** Previous / next buttons for a `.rail` (scripts/carousel.ts wires them up). */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  /** What the rail holds, for screen readers, e.g. "reviews". */
  label: string;
  class?: string;
}
const { label, class: cls } = Astro.props;
---

<div class:list={['rail-nav', cls]}>
  <button class="rail-nav__btn rail-nav__btn--prev" type="button" aria-label={`Previous ${label}`} data-carousel-prev>
    <Icon name="arrow-right" size={18} />
  </button>
  <button class="rail-nav__btn" type="button" aria-label={`More ${label}`} data-carousel-next>
    <Icon name="arrow-right" size={18} />
  </button>
</div>
