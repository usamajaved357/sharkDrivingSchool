---
import BookingWizard from '@/components/booking/BookingWizard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book a Driving Lesson"
  description="Book a manual or automatic driving lesson in Manchester online in under a minute. Pick a time and we'll pick you up from home, work or college."
  chrome="focused"
  crumbs={[{ name: 'Book a lesson', path: '/book/' }]}
  bodyClass="page-book"
>
  <BookingWizard />
</BaseLayout>

<style is:global>
  body.page-book {
    background: var(--paper);
  }
</style>
