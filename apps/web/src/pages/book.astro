---
import EnquiryWizard from '@/components/enquiry/EnquiryWizard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book Driving Lessons in Manchester"
  description="Send your details in a minute and we'll call or WhatsApp you to arrange manual or automatic driving lessons in Manchester, with free pick-up from home, work or college."
  chrome="focused"
  crumbs={[{ name: 'Book a lesson', path: '/book/' }]}
  bodyClass="page-book"
>
  <EnquiryWizard />
</BaseLayout>

<style is:global>
  body.page-book {
    background: var(--paper);
  }
</style>
