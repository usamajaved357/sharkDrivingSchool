---
/**
 * Legal pages: /privacy, /terms, /cookies.
 * Content lives in data/legal/*; business details in config/site.ts (`legal`).
 */
import LegalBody from '@/components/legal/LegalBody.astro';
import LegalHero from '@/components/legal/LegalHero.astro';
import { legalDocs, type LegalDoc } from '@/data/legal';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return legalDocs.map((doc) => ({ params: { legal: doc.slug }, props: { doc } }));
}

interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
---

<BaseLayout title={doc.title} description={doc.description} chrome="compact">
  <LegalHero doc={doc} />
  <LegalBody doc={doc} />
</BaseLayout>
