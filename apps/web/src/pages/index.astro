---
import AreasCoverage from '@/components/home/AreasCoverage.astro';
import AreasMarquee from '@/components/home/AreasMarquee.astro';
import CareersBanner from '@/components/home/CareersBanner.astro';
import CoursesBento from '@/components/home/CoursesBento.astro';
import Faq from '@/components/home/Faq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import Hero from '@/components/home/Hero.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import PricingPreview from '@/components/home/PricingPreview.astro';
import Reviews from '@/components/home/Reviews.astro';
import Stats from '@/components/home/Stats.astro';
import WhyShark from '@/components/home/WhyShark.astro';
import { site } from '@/config/site';
import { fromPrice } from '@/data/pricing';
import BaseLayout from '@/layouts/BaseLayout.astro';

// ~155 characters: what Google shows under the title.
const description = `Driving lessons in Manchester from ${fromPrice('single')}/hr. Manual & automatic, DVSA-approved instructors, free pick-up and flexible slots. Call ${site.phone.display}.`;
---

<BaseLayout title="Driving Lessons in Manchester | Shark Driving School" description={description}>
  <Hero />
  <AreasMarquee />
  <Stats />
  <CoursesBento />
  <PricingPreview />
  <HowItWorks />
  <WhyShark />
  <Reviews />
  <AreasCoverage />
  <CareersBanner />
  <Faq />
  <FinalCta />
</BaseLayout>
